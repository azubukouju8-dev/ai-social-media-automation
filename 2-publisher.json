      "name": "Get Due Posts"
    },
    {
      "parameters": {
        "jsCode": "// SIMULATED PUBLISHER\n// In a real build, each platform would be an API call\n// (Meta Graph API, TikTok, LinkedIn). Here we fake it,\n// with a random chance of failure so we can demo error handling.\n\nconst TIMEZONE = 'America/Los_Angeles';\nconst FAIL_RATE = 0.3; // 30% chance each platform fails\nconst PLATFORMS = ['Instagram', 'TikTok', 'Facebook', 'LinkedIn'];\nconst ERRORS = [\n  'API rate limit exceeded (429)',\n  'Access token expired (401)',\n  'Media upload failed: file too large',\n  'Platform temporarily unavailable (503)',\n];\n\nreturn $input.all().map(item => {\n  const record = item.json;\n  const fields = record.fields || record;\n  const time = DateTime.now().setZone(TIMEZONE).toFormat('yyyy-MM-dd HH:mm');\n\n  // Is this a video post?\n  const video = Array.isArray(fields.Video) && fields.Video.length ? fields.Video[0] : null;\n  const postType = video ? 'Video' : 'Post';\n\n  const results = PLATFORMS.map(platform => {\n    if (!fields[platform]) {\n      return { platform, ok: false, message: 'No caption for this platform' };\n    }\n    if (Math.random() < FAIL_RATE) {\n      const error = ERRORS[Math.floor(Math.random() * ERRORS.length)];\n      return { platform, ok: false, message: error };\n    }\n    const postId = platform.toLowerCase() + '_' + Math.random().toString(36).slice(2, 10);\n    return { platform, ok: true, message: `${postType} published (ID: ${postId})` };\n  });\n\n  const failed = results.filter(r => !r.ok);\n  const lines = results.map(r => `${r.ok ? '✅' : '❌'} ${r.platform}: ${r.message}`);\n  if (video) lines.unshift(`🎬 Video: ${video.filename}`);\n\n  return {\n    json: {\n      id: record.id,\n      title: fields.Title,\n      status: failed.length === 0 ? 'Published' : 'Failed',\n      failedPlatforms: failed.map(r => r.platform).join(', '),\n      log: `[${time}]\\n${lines.join('\\n')}`,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -80
      ],
