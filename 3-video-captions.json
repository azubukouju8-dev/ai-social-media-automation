    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a social media content strategist.\n\nBusiness brief: {{ $('Get New Videos').item.json.fields.Brief }}\n\nWhat the video shows: {{ $json.content.parts[0].text }}\n\nWrite captions for posting THIS video on each platform. The captions must match what actually happens in the video and connect it to the business brief. Write a different version for each platform:\n- instagram: Reel caption with a strong hook, emojis, line breaks, 8-12 hashtags at the end\n- tiktok: short punchy caption under 150 characters, 3-5 hashtags\n- facebook: friendly and conversational, 2-3 short paragraphs, clear call to action\n- linkedin: professional tone, business value or a story, max 3 hashtags",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
