      ],
      "id": "2b15ec59-6930-441f-8a23-a51afddc4981",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "// The client's time zone. Change this to match where the client is.\nconst TIMEZONE = 'America/Los_Angeles';\nconst POST_HOUR = 10; // posts go out at 10:00 AM client time\n\nconst form = $('On form submission').first().json;\nconst posts = $input.first().json.output.posts;\n\nreturn posts.map((post, i) => {\n  // Start Date at 10:00 AM in the client's time zone, plus 1 day per post\n  const scheduled = DateTime\n    .fromISO(form['Start Date'], { zone: TIMEZONE })\n    .set({ hour: POST_HOUR, minute: 0, second: 0 })\n    .plus({ days: i });\n\n  return {\n    json: {\n      ...post,\n      brief: `${form['Business Name']}: ${form['Topic']}`,\n      scheduled_time: scheduled.toISO(),\n    },\n  };\n});"
      },
