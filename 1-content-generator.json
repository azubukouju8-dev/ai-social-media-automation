    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a social media content strategist.\n\nBusiness: {{ $json[\"Business Name\"] }}\nAbout the business: {{ $json[\"Business Description\"] }}\nCampaign topic: {{ $json[\"Topic\"] }}\n\nCreate exactly {{ $json[\"Number of Posts\"] }} different posts for this campaign. For each post, write a separate version for every platform. Do not copy the same text across platforms:\n- title: a short internal name for the post\n- instagram: engaging caption with emojis, line breaks, and 8-12 hashtags at the end\n- tiktok: short punchy caption under 150 characters with 3-5 hashtags\n- facebook: friendly and conversational, 2-3 short paragraphs, clear call to action\n- linkedin: professional tone, focused on business value or a story, max 3 hashtags\n- image_prompt: a detailed description for an AI image generator to create the post image\n- video_script: a 15-30 second Reel/TikTok script with scene-by-scene directions and on-screen text",
        "hasOutputParser": true,
        "messages": {
          "messageValues": []
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
